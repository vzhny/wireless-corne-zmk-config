#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/* Active key positions — outer columns (0,11,12,23,24,35) excluded */

#define KEYS_L  1  2  3  4  5  13 14 15 16 17 25 26 27 28 29
#define KEYS_R  6  7  8  9  10 18 19 20 21 22 30 31 32 33 34
#define THUMBS  36 37 38 39 40 41

/ {
    chosen { zmk,physical-layout = &foostan_corne_6col_layout; };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        /* Thumb shift/key: tap = key, hold = modifier, tap-then-hold = repeat key. */
        thm: thm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        /* Holding NUM (mo 3) + FUNC (mo 6) activates ADMIN; so does NUM + NAV.
         * Neither needs a dedicated thumb key.
         *
         * ADMIN's layer index (7) must stay higher than every layer it can
         * combine with (FUNC=6, NAV=4): the display shows whichever active
         * layer has the highest index, so a lower-numbered conditional
         * layer would take effect for key bindings but never show up on
         * screen. */

        admin {
            if-layers = <3 6>;
            then-layer = <7>;
        };

        admin_leftonly {
            if-layers = <3 4>;
            then-layer = <7>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Positions reference layer 0. No 'layers' restriction — combos fire in
         * all contexts (base, MAC overlay, and utility layers). */
        /* Non-adjacent combos — lower roll risk, no prior-idle guard needed */

        combo_tab {
            timeout-ms = <40>;
            key-positions = <1 2>;
            bindings = <&kp TAB>;
        };

        combo_ret {
            timeout-ms = <40>;
            key-positions = <1 4>;
            bindings = <&kp RET>;
        };

        combo_esc {
            timeout-ms = <40>;
            key-positions = <13 16>;
            bindings = <&kp ESC>;
        };

        combo_sqt {
            timeout-ms = <40>;
            key-positions = <21 22>;
            bindings = <&kp SQT>;
        };

        /* Adjacent/roll-prone combos — require-prior-idle-ms 150 gates fast typing
         * rolls. If misfires persist, raise timeout-ms (primary tuning knob).
         *
         * Win/Mac split: base profile layer (0/1 Win, 2 Mac) stays active
         * underneath any stacked momentary layer (NUM/NAV/SYM/FUNC/ADMIN), so
         * restricting by base layer here still fires correctly while those are
         * held - see is_mac note in blecorne_central.h/.c for why this can't
         * just read highest-active-layer instead. */

        combo_undo {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <25 38>;
            layers = <0 1>;
            bindings = <&kp LC(Z)>;
        };

        combo_undo_mac {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <25 38>;
            layers = <2>;
            bindings = <&kp LG(Z)>;
        };

        combo_cut {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <25 26>;
            layers = <0 1>;
            bindings = <&kp LC(X)>;
        };

        combo_cut_mac {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <25 26>;
            layers = <2>;
            bindings = <&kp LG(X)>;
        };

        combo_copy {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <26 27>;
            layers = <0 1>;
            bindings = <&kp LC(C)>;
        };

        combo_copy_mac {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <26 27>;
            layers = <2>;
            bindings = <&kp LG(C)>;
        };

        combo_paste {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <27 28>;
            layers = <0 1>;
            bindings = <&kp LC(V)>;
        };

        combo_paste_mac {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <27 28>;
            layers = <2>;
            bindings = <&kp LG(V)>;
        };

        /* Both shift thumbs simultaneously → Caps Word */
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <38 39>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_win_layer {
            display-name = "Qwerty (Win)";
            bindings = <
&none          &kp Q         &kp W        &kp E        &kp R  &kp T            &kp Y           &kp U  &kp I        &kp O        &kp P            &none
&none          &hml LCTRL A  &hml LGUI S  &hml LALT D  &kp F  &kp G            &kp H           &kp J  &hmr RALT K  &hmr RGUI L  &hmr RCTRL SEMI  &none
&none          &lt 4 Z       &kp X        &kp C        &kp V  &kp B            &kp N           &kp M  &kp COMMA    &kp DOT      &lt 5 FSLH       &none
                                &kp BACKSPACE  &mo 3  &thm LSHFT SPACE  &thm RSHFT BSPC  &mo 6  &kp ENTER
            >;
        };

        /* QWERTY WIN "profile" toggle target — fully transparent, no bindings
         * of its own (identical to being on layer 0 alone). Exists only so
         * "return to Qwerty Win" can be an explicit &tog target symmetric with
         * the other profile below, instead of relying on toggling it off by
         * hand. is_mac on the display keys off the specific profile layer
         * that is active (zmk_keymap_layer_active), not "highest active
         * layer", so this layer needs no real bindings to work correctly -
         * see blecorne_central.c / modifier_sync_central.c.
         * Activated via &tog 1 from ADMIN. */

        qwerty_win_profile_layer {
            display-name = "Qwerty (Win)";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* QWERTY MAC overlay — swaps Ctrl↔GUI on homerow only; everything else transparent.
         * Activated via &tog 2 from ADMIN. &tog state is runtime-only (not written
         * to NVS), so this layer is always off on power cycle.
         * Layer 2 < NUM(3)/NAV(4)/SYM(5): those layers always win on scan. */

        qwerty_mac_layer {
            display-name = "Qwerty (Mac)";
            bindings = <
&trans  &trans       &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans          &trans
&trans  &hml LGUI A  &hml LCTRL S  &trans  &trans  &trans  &trans  &trans  &trans  &hmr RCTRL L  &hmr RGUI SEMI  &trans
&trans  &trans       &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans          &trans
                                   &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* NUM — left: 1-5 top row, 6-0 homerow; right: &trans */

        num_layer {
            display-name = "Numbers";
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp NUMBER_6  &kp N7        &kp N8        &kp NUMBER_9  &kp NUMBER_0  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans        &trans        &trans        &trans  &trans  &trans
            >;
        };

        /* NAV — right homerow: hjkl arrows; right top: home/pgup/pgdn/end;
         * right bottom: Ctrl+Left/Right word motions; left: del + vol */

        nav_layer {
            display-name = "Navigation";
            bindings = <
&trans  &trans  &trans      &trans  &trans        &trans        &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans  &trans
&trans  &trans  &trans      &trans  &kp C_VOL_DN  &kp C_VOL_UP  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans  &trans
&trans  &trans  &kp DELETE  &trans  &trans        &trans        &trans    &trans         &trans       &trans     &trans  &trans
                            &trans  &trans        &trans        &trans    &trans         &trans
            >;
        };

        sym_layer {
            display-name = "Symbols";
            bindings = <
&trans  &kp MINUS      &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp AMPERSAND  &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp ASTERISK   &kp SLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NON_US_BACKSLASH  &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans                &trans                 &trans                &trans  &trans  &trans
            >;
        };

        /* FUNC — must stay numerically lower than ADMIN, see conditional_layers above. */

        func_layer {
            display-name = "Function Keys";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
                          &trans  &trans  &trans   &trans  &trans  &trans
            >;
        };

        /* ADMIN — conditional: NUM(3) + FUNC(6) held simultaneously.
         * Top row left: BT device select 0-3, BT clear.
         * Top row right: sys_reset, bootloader.
         * Homerow left: tog 1 = Qwerty Win, tog 2 = Qwerty Mac.
         * Homerow right H: studio unlock.
         * All tog states are runtime-only — always off on power cycle (Qwerty Win default). */

        admin_layer {
            display-name = "Admin";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &sys_reset      &bootloader  &trans  &trans  &trans  &trans
&trans  &tog 1        &tog 2        &trans        &trans        &trans      &studio_unlock  &trans       &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans      &trans          &trans       &trans  &trans  &trans  &trans
                                    &trans        &trans        &trans      &trans          &trans       &trans
            >;
        };
    };
};
